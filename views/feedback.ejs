<!DOCTYPE html>
<html lang="ru">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width,initial-scale=1">
  <title>Нори — сайт чёрной кошки</title>
  <meta name="keywords" content="кот, кошка, Нори, питомец, портфолио, животные">
  <meta name="description" content="Мини-сайт чёрной кошки Нори — биография, фото, советы по уходу и контактная форма.">

  <!-- Google Fonts -->
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Poppins:wght@300;400;600;700&display=swap" rel="stylesheet">

  <!-- Styles -->
  <link rel="stylesheet" href="/styles.css">
</head>
<body>

  <%- include('partials/header', { loggedIn }) %>

  <main class="page-main">

    <section class="feedback">
      <h2 class="section__title">Оставить отзыв о Нори</h2>

      <form id="feedback-form" class="form">
        <label>Имя</label>
        <input type="text" id="username" required minlength="2">

        <label>Email</label>
        <input type="email" id="email" required>

        <label>Сообщение</label>
        <textarea id="message" required minlength="5"></textarea>

        <button type="submit">Добавить отзыв</button>
      </form>

      <div id="reviews"></div>
    </section>

    <template id="review-template">
      <article class="review">
        <h3 class="review__name"></h3>
        <p class="review__email"></p>
        <p class="review__text"></p>
        <button class="review__edit">Редактировать</button>
      </article>
    </template>

  </main>

  <%- include('partials/footer') %>

  <!-- скрипты -->
  <script src="/feedback.js" defer></script>
  <%- include('partials/scripts') %>

</body>
</html>